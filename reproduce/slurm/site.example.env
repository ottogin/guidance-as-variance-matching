# Copy to reproduce/slurm/site.env (git-ignored) and fill in for your cluster. Every path is yours to choose.
export PY=/path/to/python                   # an env with: pip install -e .[models,figures]  (reproduce/envs/*.lock.txt)
export PY_video=/path/to/python             # job.sbatch --env video: the core env plus av and imageio-ffmpeg
export PY_ucf=/path/to/python               # --env ucf (SVD, Latte): the core env plus av
export PY_cosmos=/path/to/python            # --env cosmos: Cosmos-Predict2.5's own environment (vmg/models/cosmos.py)
export PY_audio=/path/to/python             # --env audio (AudioLDM 2): the core env plus torchaudio, soundfile, pyarrow
export PY_sao=/path/to/python               # --env sao: stable-audio-tools 0.0.19 (its own pins; reproduce/envs)
export PY_mdm=/path/to/python               # --env mdm: MDM's environment (clip, spacy)
export PY_saomet=/path/to/python            # --env saomet: stable-audio-metrics' own pins (Stable Audio Open's metrics)
export VMG_RUNS=/path/to/runs                # every pipeline output (moments, w.json, samples, metrics)
export VMG_DATA=/path/to/data                # default parent of the dataset folders below (vmg/data/*.py fetch)
export VMG_WEIGHTS=/path/to/weights          # optional local mirror: <VMG_WEIGHTS>/<org>/<repo>/
export HF_HOME=/path/to/hf                   # Hugging Face cache (gated models need HF_TOKEN or a login)
export PYTHONPATH=$PWD                       # the repository itself
export MPLBACKEND=Agg PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# datasets that live elsewhere than $VMG_DATA/<name> (each defaults to that)
export VMG_COCO=$VMG_DATA/coco VMG_MJHQ=$VMG_DATA/mjhq VMG_OPENVID=$VMG_DATA/openvid
export VMG_IMAGENET=/path/to/imagenet        # manual download (ILSVRC2012 val); see vmg/data/imagenet.py
export VMG_IMAGENET_TRAIN_LMDB=/path/to/train.lmdb   # the ILSVRC2012 train set as an LMDB, for the EDM2-XS trainings
                                            # (reproduce/experiments/seedpair_in64.py prep says the format)
export VMG_CIFAR10=$VMG_DATA/cifar10
export VMG_UCF101=$VMG_DATA/ucf101 VMG_BRIDGE=$VMG_DATA/bridge VMG_AUDIOCAPS=$VMG_DATA/audiocaps
export VMG_SONGDESCRIBER=$VMG_DATA/songdescriber
export VMG_DOCCI=$VMG_DATA/docci             # DOCCI (fig:wmse-published's text-to-image pairs; vmg/data/docci.py)
export VMG_MDM_ROOT=/path/to/motion-diffusion-model   # MDM's repository with KIT-ML and its checkpoint (vmg/data/kitml.py)
export VMG_CLIP_CACHE=/path/to/clip-cache            # optional: CLIP ViT-B/32 for MDM's text encoder
export VMG_LATTE_REPO=/path/to/Latte VMG_COSMOS=/path/to/cosmos   # Latte's repository; Cosmos-Predict2.5's setup
# third-party code, cloned at pinned commits (python -m vmg.models._edm clone); never copied into this repository
export VMG_EDM2=/path/to/src/edm2            # github.com/NVlabs/edm2: its torch_utils unpickles NVIDIA's networks
export VMG_SRC=/path/to/src                  # DiT/ SiT/ U-ViT/ REPA/ MaskDiT/ clones
export DNNLIB_CACHE_DIR=/path/to/cache/dnnlib VMG_CACHE=/path/to/cache   # detector and checkpoint downloads
export VMG_AUDIO_REPOS=/path/to/src/audio   # torchvggish, audioldm_eval (a2fde54), AudioLDM2: see reproduce/envs/README.md
export VMG_SAO_METRICS=/path/to/stable-audio-metrics   # with load/clap_score/630k-audioset-fusion-best.pt
# writable caches (the audio detectors download into TORCH_HOME); set HOME too only if yours is not writable
export TORCH_HOME=/path/to/torch XDG_CACHE_HOME=/path/to/cache NUMBA_CACHE_DIR=/path/to/cache/numba
# what reproduce/run_all.py --launcher slurm passes to sbatch for GPU and for CPU jobs. --time must cover the longest
# single task: the EDM2 trainings (Slurm scripts, with their own --gres) take ~7.5 h on 8 H200s (train_xs_2e27) and
# ~10 h on 4 (train_seedpair), and a job cut at its time limit is not requeued.
export VMG_SBATCH_GPU="-p <gpu partition> --account=<account> --gres=gpu:1 -c 8 --mem=64G --time=12:00:00"
export VMG_SBATCH_CPU="-p <cpu partition> --account=<account> -c 8 --mem=32G --time=02:00:00"
# jobs pinned to one GPU type (reproduce/plan.py EVAL_GPU: AudioLDM 2's evaluation, whose reference records it)
export VMG_SBATCH_GPU_L40S="-p <gpu partition> --account=<account> --gres=gpu:l40s:1 -c 8 --mem=64G --time=04:00:00"
